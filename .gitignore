/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# inngest
.inngest/main.db

# clerk configuration (can include secrets)
/.clerk/

# python — the analysis layer
#
# A virtualenv is several thousand files. Without this, `git status` after
# `pip install -e .` reports around 1900 changes and the real diff becomes
# impossible to read — which is how unrelated things get committed by
# accident.
#
# `analysis/data/` is deliberately NOT ignored: the run snapshot is the
# point. Every row in it cost a sandbox and real tokens, the database is
# the only other copy, and `npm run report prune` deletes rows by design.
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
.ruff_cache/

# scratch output from redirecting a report to a file
out.txt
